# Password per sbloccare la modalità Admin (OBBLIGATORIA in produzione su Vercel)
ADMIN_PASSWORD=admin1234

# (Opzionale ma consigliato) Persistenza condivisa dei risultati tramite Upstash Redis / Vercel KV.
# Su Vercel: Storage -> Marketplace -> Upstash Redis -> collega al progetto: le variabili vengono create in automatico.
# Senza queste variabili i risultati vengono salvati solo nel browser dell'admin (localStorage).
KV_REST_API_URL=
KV_REST_API_TOKEN=
